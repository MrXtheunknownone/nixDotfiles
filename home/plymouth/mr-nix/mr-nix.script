Window.SetBackgroundTopColor(0.024, 0.031, 0.039);
Window.SetBackgroundBottomColor(0.024, 0.031, 0.039);

logo_img = Image("mr-nix-logo.png");
logo_sprite = Sprite(logo_img);
logo_x = Math.Int((Window.GetWidth() - logo_img.GetWidth()) / 2);
logo_y = Math.Int((Window.GetHeight() - logo_img.GetHeight()) / 2) - 60;
logo_sprite.SetX(logo_x);
logo_sprite.SetY(logo_y);
logo_sprite.SetOpacity(1);
