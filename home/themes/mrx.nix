# LCARS MRX — Everforest hard dark + Catppuccin Mocha
# Token names match picard.nix exactly — the CSS/RASI consumers don't change.
{
  bg     = "#232a2e";
  ink    = "#1c2326";
  well   = "#2d353b";
  seg    = "#3d484d";
  blue   = "#a7c080";   # primary accent — warm muted green (Everforest)
  bright = "#83c092";   # bright / active — cool aqua (Everforest)
  mdblue = "#2e6b3c";   # mid accent / selected — dark forest green
  term   = "#3a8c48";   # LCARS endcap + critical — deep forest green
  notif  = "#e67e80";   # notification — muted rose (Everforest red)
  vol    = "#dbbc7f";   # volume — warm yellow (Everforest yellow)
  vpn    = "#74c7ec";   # VPN — sapphire sky (Catppuccin sapphire)
  gray   = "#7a8478";
  lgray  = "#9da9a0";
  ghost  = "#d3c6aa";   # warm off-white (Everforest fg)
  star   = "#cdd6f4";   # cool bright text (Catppuccin text)
}
