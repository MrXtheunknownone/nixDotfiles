# LCARS Picard — cold-blue palette
# Token names are the shared contract across all themes.
# All apps reference these names; swap the file to change the theme.
{
  bg     = "#000000";
  ink    = "#06080c";
  well   = "#1c3c55";
  seg    = "#2f3749";
  blue   = "#37a6d1";   # primary accent
  bright = "#41c4f7";   # bright / active
  mdblue = "#2a7193";   # mid accent / selected
  term   = "#e7442a";   # LCARS endcap + critical states
  notif  = "#ff6753";   # notification accent
  vol    = "#ff977b";   # volume
  vpn    = "#4daa6e";   # VPN indicator
  gray   = "#6d748c";
  lgray  = "#9ea5ba";
  ghost  = "#d2d5df";
  star   = "#f3f4f7";
}
